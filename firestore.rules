rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /homecamStations/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, write: if isOwner();

      // Station device-health heartbeat. Restrict to the owner and
      // the single telemetry document used by smart device management.
      // Parent document permissions do not apply to subcollections.
      match /telemetry/health {
        allow read, write: if isOwner();
      }

      // Video never traverses Firestore: only SDP and ICE candidates.
      match /sessions/{sessionId} {
        allow read, write: if isOwner();

        match /viewerCandidates/{candidateId} {
          allow read, write: if isOwner();
        }
        match /stationCandidates/{candidateId} {
          allow read, write: if isOwner();
        }
      }
    }
  }
}
